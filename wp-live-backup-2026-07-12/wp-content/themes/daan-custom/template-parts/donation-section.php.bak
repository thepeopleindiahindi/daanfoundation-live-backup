<?php
/**
 * Full-Width Donation Section Template Part
 *
 * Two-column layout: LEFT = donation form, RIGHT = hero image.
 * Replaces the old sidebar widget.
 *
 * Accepts: $args['default_cause'], $args['hero_image']
 */
$default_cause = $args['default_cause'] ?? 'Where Most Needed';
$hero_image    = $args['hero_image'] ?? '';
$causes        = array( 'Where Most Needed', 'Community Kitchen', 'Ramadan Iftar', 'Zakat', 'Sadaqah', 'Fidyah & Kaffarah' );
$preset_amount = 1000;
$default_label = '';
foreach ( $causes as $c ) {
    $slug = strtolower( str_replace( array( ' & ', ' ' ), array( '-', '-' ), $c ) );
    if ( $slug === $default_cause ) {
        $default_label = $c;
        break;
    }
}
if ( ! $default_label ) {
    $map = array(
        'zakat'    => 'Zakat',
        'sadaqah'  => 'Sadaqah',
        'fidya-kaffarah' => 'Fidyah & Kaffarah',
        'community-kitchen' => 'Community Kitchen',
        'ramadan-iftar'     => 'Ramadan Iftar',
        'where-needed'      => 'Where Most Needed',
    );
    $default_label = isset( $map[ $default_cause ] ) ? $map[ $default_cause ] : 'Where Most Needed';
}
?>

<section class="da-donation-section">
    <div class="da-donation-inner">
        <!-- LEFT COLUMN: Donation Form -->
        <div class="da-donation-form-col">
            <div class="da-donation-card">
                <h2 class="da-donation-heading">Choose an Amount</h2>

                <div class="da-cause-select">
                    <label for="da-cause">Select a Cause</label>
                    <select id="da-cause" class="da-select">
                        <?php foreach ( $causes as $c ) : ?>
                            <option value="<?php echo esc_attr( $c ); ?>" <?php selected( $c, $default_label ); ?>><?php echo esc_html( $c ); ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>

                <div class="da-amount-row">
                    <?php foreach ( array( 500, 1000, 2500, 5000 ) as $amt ) : ?>
                        <button type="button" class="da-amount-pill <?php echo $amt === 1000 ? 'active' : ''; ?>" data-amount="<?php echo $amt; ?>">₹<?php echo $amt; ?></button>
                    <?php endforeach; ?>
                    <button type="button" class="da-amount-pill da-amount-other" data-amount="other">Other</button>
                </div>

                <div id="da-other-wrap" class="da-other-wrap" style="display:none;">
                    <span class="da-other-currency">₹</span>
                    <input type="number" id="da-other-input" class="da-other-input" placeholder="Enter amount" min="1">
                </div>

                <p id="da-impact-text" class="da-impact-text">₹1,000 can provide 17 meals through our Community Kitchen</p>

                <button type="button" id="da-donate-btn" class="da-donate-btn">Donate Now &rarr;</button>

                <div class="da-payment-row">
                    <span class="da-payment-icon da-payment-visa">Visa</span>
                    <span class="da-payment-icon da-payment-mastercard">Mastercard</span>
                    <span class="da-payment-icon da-payment-upi">UPI</span>
                    <span class="da-payment-icon da-payment-phonepe">PhonePe</span>
                    <span class="da-payment-icon da-payment-gpay">G Pay</span>
                    <span class="da-payment-icon da-payment-paytm">Paytm</span>
                </div>
                <p class="da-secure-text">&#x1f512; 100% Secure &bull; Registered Charity</p>
            </div>
        </div>

        <!-- RIGHT COLUMN: Hero Image -->
        <div class="da-donation-image-col">
            <?php if ( $hero_image ) : ?>
                <div class="da-image-wrap">
                    <img src="<?php echo esc_url( $hero_image ); ?>" alt="Daan Foundation" class="da-hero-img">
                    <div class="da-image-overlay">
                        <div class="da-overlay-content">
                            <span class="da-overlay-stat">500,000+</span>
                            <span class="da-overlay-label">Meals Served Since 2020</span>
                        </div>
                    </div>
                </div>
            <?php endif; ?>
        </div>
    </div>
</section>

<script>
(function() {
    var currentAmount = 1000;
    var impactMap = {
        500: '\u20b9500 can provide 8 meals through our Community Kitchen',
        1000: '\u20b91,000 can provide 17 meals through our Community Kitchen',
        2500: '\u20b92,500 can provide 42 meals through our Community Kitchen',
        5000: '\u20b95,000 can provide 85 meals through our Community Kitchen'
    };
    var impactEl = document.getElementById('da-impact-text');
    var otherWrap = document.getElementById('da-other-wrap');
    var otherInput = document.getElementById('da-other-input');
    var donateBtn = document.getElementById('da-donate-btn');
    var causeSelect = document.getElementById('da-cause');

    function updateImpact(amount) {
        if (impactEl) {
            impactEl.textContent = impactMap[amount] || 'Every meal makes a difference';
        }
    }

    function deselectAll() {
        document.querySelectorAll('.da-amount-pill').forEach(function(b) {
            b.classList.remove('active');
        });
    }

    document.querySelectorAll('.da-amount-pill').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var data = btn.getAttribute('data-amount');
            if (data === 'other') {
                deselectAll();
                btn.classList.add('active');
                if (otherWrap) otherWrap.style.display = 'block';
                if (otherInput) {
                    otherInput.focus();
                    var val = parseInt(otherInput.value) || 0;
                    if (val > 0) {
                        currentAmount = val;
                        updateImpact(val);
                    } else {
                        if (impactEl) impactEl.textContent = 'Enter your custom amount below';
                    }
                }
                return;
            }
            var amt = parseInt(data);
            deselectAll();
            btn.classList.add('active');
            if (otherWrap) otherWrap.style.display = 'none';
            if (otherInput) otherInput.value = '';
            currentAmount = amt;
            updateImpact(amt);
        });
    });

    if (otherInput) {
        otherInput.addEventListener('input', function() {
            var val = parseInt(this.value) || 0;
            if (val > 0) {
                currentAmount = val;
                updateImpact(val);
            }
        });
    }

    if (donateBtn) {
        donateBtn.addEventListener('click', function() {
            var amount = currentAmount || 1000;
            var cause = causeSelect ? causeSelect.value : 'Where Most Needed';
            window.location.href = '/donate?amount=' + amount + '&cause=' + encodeURIComponent(cause);
        });
    }
})();
</script>
